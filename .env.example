# Local development only. Copy to `.env`, which is gitignored and never enters the image.
# In Lambda these arrive as function environment variables; `pydantic-settings` reads the
# process environment and a dotenv file identically, so there is one contract, not two.

# Required for /recommend. Without it the route still answers 200 with `action: null`
# and a reason -- a missing key is a degraded service, not a broken one.
ANTHROPIC_API_KEY=sk-ant-...

# DEBUG | INFO | WARNING | ERROR. INFO emits one JSON line per request.
LOG_LEVEL=INFO

# Build-time only, read by `churn.train` when it stamps the artifact -- never read at
# request time. The deployed image sets it to the commit being built; locally, leaving it
# unset gives you `<package version>+<short sha>` off your working tree instead.
# MODEL_VERSION=0.1.0+abc1234

# Escape hatch for pointing a local server at an artifact built somewhere other than
# ./artifacts. The image does not set it -- the file lands at the default path.
# ARTIFACT_PATH=artifacts/model.joblib
